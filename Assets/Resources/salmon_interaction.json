{
    "character": "salmon",
    "icon_on_detected": true,
    "expressions": {
        "default": "Eyes_Blink",
        "start_dialogue": "Sweat_L",
        "post_interaction": "Eyes_Happy"
    },
    "dialogue_sequence": [
        {
            "type": "player_detects",
            "dialogue": null,
            "action": "remove_question_icon"
        },
        {
            "type": "salmon",
            "expression": "Sweat_L",
            "dialogue": "고래님, 혹시 바쁘시지 않다면…\n잠깐 도움을 요청해도 괜찮을까요?",
            "voice": ""
        },
        {
            "type": "salmon",
            "expression": "Sweat_L",
            "dialogue": "아내가 곧 알을 낳아야 하는데...\n보시다시피 주변이 온통 쓰레기예요.",
            "voice": ""
        },
        {
            "type": "salmon",
            "expression": "Sweat_L",
            "dialogue": "알은 깨끗하고 조용한 곳에서 안전하게 태어나야 하거든요.\n이대로는 너무 위험해요.",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "그러게. 주변에 쓰레기가 너무 많이 흩어져 있구나.\n이 상태로는 알을 낳기 어렵겠는걸?",
            "voice": ""
        },
        {
            "type": "salmon",
            "expression": "Eyes_Sad",
            "dialogue": "이 <color=#FFD700>무거운 고철 쓰레기들</color>이 너무 무거워서 저희 힘으론 안 돼요...\n아내가 계속 불안해하고 있어요.",
            "voice": ""
        },
        {
            "type": "salmon",
            "expression": "Sweat_L",
            "dialogue": "혹시 이 고철들을 한 번에 치워주실 방법이 없을까요?",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_Blink",
            "dialogue": "(고철 쓰레기라... 범고래를 도와줬을 때처럼 그 도구를 쓰면 되겠어!)",
            "voice": ""
        },
        {
            "type": "interaction",
            "dialogue": null,
            "action": "자석 아이템 사용해 주변 고철 쓰레기 제거"
        },
        {
            "type": "salmon",
            "expression": "Eyes_Happy",
            "dialogue": "고래님 덕분에 주변이 많이 정리됐습니다.\n바닥도 한결 깨끗해졌네요. 정말 감사합니다!",
            "voice": ""
        },
        {
            "type": "salmon",
            "expression": "Eyes_Blink",
            "dialogue": "도와주신 은혜에 보답하고 싶은데...\n참, 저희가 장소를 찾다가 구석에서 이상한 물건을 하나 주웠거든요.",
            "voice": ""
        },
        {
            "type": "salmon",
            "expression": "Eyes_Blink",
            "dialogue": "<color=#FFFF00>마치 게의 집게발처럼 생겼는데, 무엇이든 싹둑 잘라낼 수 있어 보였어요.</color>\n저희에겐 너무 위험해서 치워뒀는데, 고래님이라면 잘 쓰실 것 같아요.",
            "voice": ""
        },
        {
            "type": "salmon",
            "expression": "Eyes_Happy",
            "dialogue": "감사의 선물로 드릴 테니 꼭 받아주세요!",
            "voice": ""
        },
        {
            "type": "interaction",
            "dialogue": null,
            "action": "가위 아이템 획득 시스템 메시지 출력"
        },
        {
            "type": "salmon",
            "expression": "Eyes_Blink",
            "dialogue": "사실 길을 잃고 막막했을 때,\n어디선가 <color=#42A5F5>다정한 노랫소리</color>가 저희를 이쪽으로 이끌어 주었습니다.",
            "voice": ""
        },
        {
            "type": "salmon",
            "expression": "Eyes_Blink",
            "dialogue": "마치 이곳에서 조금만 기다리면, 당신이 와서 도와줄 거라고 알려주는 것 같았어요.",
            "voice": ""
        },
        {
            "type": "salmon",
            "expression": "Eyes_Happy",
            "dialogue": "이제 아내도 안심하고 이곳에서 알을 낳을 수 있을 것 같군요.\n저는 이 곳에서 아내와 곧 태어날 우리 아이들을 끝까지 지키겠습니다.",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "(<color=#42A5F5>다정한 노랫소리</color>…\n지금까지 친구들을 보살펴준 그 존재가, 어쩌면 줄곧 나를 부르고 있었던 걸지도 몰라.)",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_Sad",
            "dialogue": "(알을 낳는 데 필요한 건 거창한 게 아니었어. 깨끗하고 안전한 자리 하나.\n그 당연한 권리를 쓰레기가 가로막고 있었던 거야.)",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "(연어 부부가 준 이 선물을 유용하게 써야겠어.\n계속해서 도움이 필요한 곳으로 헤엄쳐 가보자.)",
            "voice": ""
        }
    ]
}