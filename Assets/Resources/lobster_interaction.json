{
    "character": "lobster",
    "icon_on_detected": true,
    "expressions": {
        "default": "Eyes_Blink",
        "start_dialogue": "Eyes_Annoyed",
        "post_interaction": "Eyes_Shrink"
    },
    "dialogue_sequence": [
        {
            "type": "player_detects",
            "dialogue": null,
            "action": "remove_question_icon"
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "이봐, 고래!! 나 좀 도와줘!\n젠장… 몸이 안 움직여!!",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "이 밧줄이 내 몸통을 꽉 묶고 있어서 꼼짝도 못 하겠어!\n으으… 내 집게발로도 해결이 안 돼!",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "아무리 힘을 줘도 더 조여들기만 하잖아…!",
            "voice": ""
        },
        {
            "type": "whale",
            "dialogue": "진정해. 무슨 일이야?\n아… 몸에 밧줄이 잔뜩 감겨 있네. 이러다 다치겠어."
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "그러니까 도와달라는 거잖아!!",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "갑자기 어디서 이런 밧줄이 떠내려와서는…\n내가 가만히 있다가 꼼짝없이 그대로 묶여버렸다고!",
            "voice": ""
        },
        {
            "type": "whale",
            "dialogue": "'밧줄이 단단하게 묶여 있어서 그냥 풀기는 힘들겠어.\n가위라면… 이 밧줄을 안전하게 자를 수 있을 것 같아.'"
        },
        {
            "type": "interaction",
            "dialogue": null,
            "action": "가위 아이템 사용해 밧줄 절단"
        },
        {
            "type": "lobster",
            "expression": "Eyes_Shrink",
            "dialogue": "으악! …어?\n풀렸다, 풀렸어!",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Shrink",
            "dialogue": "하, 꽁꽁 묶이는 바람에 답답해서 죽는 줄 알았네.\n고래! 진짜 고맙다. 너가 아니었으면 정말 큰일날 뻔 했어.",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "근데 넌 여기까지 어떻게 알고 찾아온 거냐?\n내 예민한 수염에 아까부터 계속 <color=#42A5F5>미세한 진동</color>이 느껴지긴 했는데.",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Shrink",
            "dialogue": "누가 계속 노래라도 부르는 것처럼 울려서 더 신경 쓰였단 말이야.\n설마 네가 낸 소리였어?",
            "voice": ""
        },
        {
            "type": "whale",
            "dialogue": "'<color=#42A5F5>미세한 진동…?</color>\n거북이 할아버지께서 말씀하셨던 그 <color=#42A5F5>잔잔한 물살</color>과 같은 걸까?'"
        },
        {
            "type": "whale",
            "dialogue": "'누군가 계속 나를 이쪽으로 부르고 있는 게 분명해.'"
        },
        {
            "type": "whale",
            "dialogue": "난 아무 소리도 안 냈어. 그나저나 밧줄은 원래 바다에 있으면 안 되는 물건인데…\n가재 너 정말 위험할 뻔 했어."
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "사람들이 버린 쓰레기… 또 그거냐.\n이젠 정말 지긋지긋하군.",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "이렇게 질기고 단단한 게 돌아다니면…\n아무리 나처럼 강한 녀석들이라도 피할 틈이 없다고.",
            "voice": ""
        },
        {
            "type": "whale",
            "dialogue": "'가재까지 꼼짝없이 당해버리다니.\n바다가 점점 위험한 곳으로 바뀌고 있는 느낌이 드는 걸.'"
        },
        {
            "type": "whale",
            "dialogue": "'우리의 바다를 지금 이대로 방치했다간 정말 큰일날 것 같아…'"
        }
    ]
}