{
    "character": "lobster",
    "icon_on_detected": true,
    "expressions": {
        "default": "Eyes_Blink",
        "start_dialogue": "Eyes_Annoyed",
        "post_interaction": "Eyes_Shrink"
    },
    "dialogue_sequence": [
        {
            "type": "player_detects",
            "dialogue": null,
            "action": "remove_question_icon"
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "이봐, 고래!! 나 좀 도와줘!",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "이놈의 밧줄이 내 몸을 꽉 묶어서 꼼짝도 못 하겠어!",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "내 집게발로 꼬집어 봐도 끄떡없어!\n뭔가 <color=#FFFF00>더 날카로운 걸로 뚝! 잘라줘야</color> 할 것 같아!",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "(밧줄이 몸에 잔뜩 감겨 있네.\n저대로 힘을 쓰면 더 조여들어서 위험해지겠어.)",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_Blink",
            "dialogue": "(이 질긴 밧줄... 그 도구라면 단번에 끊어낼 수 있어!)",
            "voice": ""
        },
        {
            "type": "interaction",
            "dialogue": null,
            "action": "가위 아이템 사용해 밧줄 절단"
        },
        {
            "type": "lobster",
            "expression": "Eyes_Squint",
            "dialogue": "으악!",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Shrink",
            "dialogue": "어라? 드디어 풀렸구나! 풀렸어!",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Sweat_L",
            "dialogue": "온 몸이 꽁꽁 묶이는 바람에 답답해서 죽는 줄 알았네.",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Happy",
            "dialogue": "고래! 너, 진짜 고맙다. 네가 아니었으면 정말 큰일 날 뻔했어.",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Blink",
            "dialogue": "근데 넌 여기까지 어떻게 알고 찾아온 거냐?",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Blink",
            "dialogue": "내 예민한 수염에 아까부터 계속 <color=#42A5F5>미세한 진동</color> 같은 게 느껴지긴 했는데…",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Rabid",
            "dialogue": "누가 계속 노래라도 부르는 것처럼 울려서 더 신경 쓰였단 말이지.\n설마 고래 네가 낸 소리냐?",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "(<color=#42A5F5>미세한 진동</color>…? 전에 다른 친구들도 말했던\n그 <color=#42A5F5>잔잔한 노랫소리</color>를 말하는 걸까?)",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_Blink",
            "dialogue": "(나를 이쪽으로 이끌어 주는 그 목소리가 점점 뚜렷해지고 있어!)",
            "voice": ""
        },
        {
            "type": "whale",
            "dialogue": "난 아무 소리도 안 냈어. 그나저나 밧줄은 원래 바다에 있으면 안 되는 물건인데\n가재 너 정말 위험할 뻔했어.",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Rabid",
            "dialogue": "흠.. 바다에 있으면 안 되는 물건이라면, 사람들이 버린 쓰레기!\n또 그거란 말이지? 이젠 정말 지긋지긋하군.",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "이렇게 질기고 단단한 게 돌아다니면…\n나처럼 강한 녀석들도 피할 틈이 없다고~",
            "voice": ""
        },
        {
            "type": "lobster",
            "expression": "Eyes_Annoyed",
            "dialogue": "내 가족들도 나처럼 이런 일을 당할까 봐 걱정이 이만저만이 아니야.\n도대체 이런 게 바다에 왜 있는 거야?!",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Sweat_R",
            "dialogue": "(단단한 껍질을 가진 가재까지 꼼짝없이 당해버리다니...\n바다가 점점 위험한 곳으로 바뀌고 있어.)",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_Sad",
            "dialogue": "(바다를 지금 이대로 두면 정말 큰일 날 것 같아…)",
            "voice": ""
        }
    ]
}