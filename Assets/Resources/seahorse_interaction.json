{
    "character": "seahorse",
    "icon_on_detected": true,
    "expressions": {
        "default": "Eyes_Blink",
        "post_interaction_start": "Sweat_L",
        "post_interaction_end": "Eyes_Happy"
    },
    "dialogue_sequence": [
        {
            "type": "player_detects",
            "dialogue": null,
            "action": "remove_question_icon"
        },
        {
            "type": "seahorse",
            "expression": "Eyes_Trauma",
            "dialogue": "으아... 꼬리가... 꼬리가 너무 아파요...",
            "voice": ""
        },
        {
            "type": "seahorse",
            "expression": "Eyes_Trauma",
            "dialogue": "해초 사이에서 쉬고 있었는데...\n이 이상한 막대기가 꼬리에 콱 끼어버렸어요!",
            "voice": ""
        },
        {
            "type": "seahorse",
            "expression": "Eyes_Sad",
            "dialogue": "꼬리가 다치면 어디에도 매달려 있을 수가 없어요...\n저처럼 작은 해마한테는 정말 큰일이에요...",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "(저건 플라스틱 빨대잖아? 꼬리에 단단히 끼어버렸네.)",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "(해마의 꼬리는 연약해서 무턱대고 당겼다간 다칠지도 몰라.)",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_Blink",
            "dialogue": "(돌고래 때처럼 조심스럽게 콕 집어내야겠어.\n그 도구라면 가능할 거야!)",
            "voice": ""
        },
        {
            "type": "interaction",
            "dialogue": null,
            "action": "핀셋 아이템 사용해 꼬리에 낀 플라스틱 빨대 제거"
        },
        {
            "type": "seahorse",
            "expression": "Eyes_Happy",
            "dialogue": "와! 드디어 꼬리가 자유로워졌어요!\n고래님이 절 구해주셨군요. 정말 고마워요...",
            "voice": ""
        },
        {
            "type": "seahorse",
            "expression": "Eyes_Sad",
            "dialogue": "제 꼬리는 저한테 손이고 발이고, 침대 같은 곳이거든요.\n이걸 잃어버릴 뻔했다고 생각하니 너무 무서웠어요...",
            "voice": ""
        },
        {
            "type": "seahorse",
            "expression": "Eyes_Blink",
            "dialogue": "사실 혼자 덜덜 떨고 있을 때...\n어디선가 <color=#1C770A>잔잔한 노랫소리</color>가 저를 감싸 안듯 들려왔어요.",
            "voice": ""
        },
        {
            "type": "seahorse",
            "expression": "Eyes_Happy",
            "dialogue": "마치 저에게 '곧 도와줄 분이 올 거야' 하고 속삭여주는 것 같았어요.",
            "voice": ""
        },
        {
            "type": "seahorse",
            "expression": "Eyes_Happy",
            "dialogue": "그 노래를 믿고 조금만 더 기다려 봤는데...\n정말 고래님이 와주셨네요!",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "(<color=#1C770A>잔잔한 노랫소리</color>... 줄곧 나를 이끌어 준 그 목소리야.)",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_Blink",
            "dialogue": "(이제 정말 가까운 곳에 있는 게 틀림없어.)",
            "voice": ""
        },
        {
            "type": "whale",
            "expression": "Eyes_Sad",
            "dialogue": "(빨대 하나가... 해마처럼 작은 친구들에겐\n손과 발을 다 빼앗는 큰 짐이 되는구나.)",
            "voice": ""
        }
    ]
}