{
  "character": "beluga",
  "icon_on_detected": true,
  "expressions": {
    "default": "Eyes_Sad",
    "start_dialogue": "Eyes_Sad",
    "post_interaction": "Eyes_Blink"
  },
    "dialogue_sequence": [
        {
            "type": "player_detects",
            "dialogue": null,
            "action": "remove_question_icon"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Annoyed",
            "dialogue": "드디어… 만나게 됐네.",
            "voice": "Dubbing_Beluga/Beluga_Audio_07"
        },
        {
            "type": "whale",
            "expression": "Eyes_Shrink",
            "dialogue": "어? 이 목소리는, <color=#2458C9>계속 나를 부르던 그 목소리잖아!</color>",
            "voice": "Dubbing_Beluga/Beluga_Audio_08"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Blink",
            "dialogue": "맞아, 내가 줄곧 너를 부르고 있었어.",
            "voice": "Dubbing_Beluga/Beluga_Audio_09"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Blink",
            "dialogue": "와줘서 고마워. 네가 꼭 와줄 거라고 믿고 있었거든.",
            "voice": "Dubbing_Beluga/Beluga_Audio_10"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Blink",
            "dialogue": "나는 <color=#2458C9>'52헤르츠'라는 주파수로 이야기하는 고래</color>야.",
            "voice": "Dubbing_Beluga/Beluga_Audio_11"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Annoyed",
            "dialogue": "이 소리는… 다른 고래들한테는 거의 들리지 않아.",
            "voice": "Dubbing_Beluga/Beluga_Audio_12"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Sad",
            "dialogue": "아무리 크게 소리쳐도, 그 누구도 듣지 못하는 바람에…\n난 항상 혼자였어.",
            "voice": "Dubbing_Beluga/Beluga_Audio_13"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Sad",
            "dialogue": "그래도 멀리서나마 친구들을 생각하며 노래했어.\n들리진 않아도, 내 간절한 마음만은 닿길 바라면서.",
            "voice": "Dubbing_Beluga/Beluga_Audio_14"
        },
        {
            "type": "whale",
            "expression": "Eyes_Blink",
            "dialogue": "아! 친구들이 가끔 느꼈다던 그 <color=#FF8DA1>따스한 기운</color>이…\n사실 네 부름이었구나.",
            "voice": "Dubbing_Beluga/Beluga_Audio_15"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Blink",
            "dialogue": "맞아. 그런데 그 부름을 내 진짜 목소리로 들어준 건, 네가 처음이야.",
            "voice": "Dubbing_Beluga/Beluga_Audio_16"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Blink",
            "dialogue": "<color=#2458C9>'52헤르츠'</color>는 보통 고래들이 낼 수 있는 주파수보다 훨씬 높아서,\n아무리 귀를 기울여도 잘 들리지 않아.",
            "voice": "Dubbing_Beluga/Beluga_Audio_17"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Blink",
            "dialogue": "어쩌면 넌… <color=#2458C9>바다가 선택한 고래</color>인지도 몰라.\n그 소리를 들을 수 있는 마음을 가지고 태어난 거지.",
            "voice": "Dubbing_Beluga/Beluga_Audio_18"
        },
        {
            "type": "whale",
            "expression": "Eyes_Blink",
            "dialogue": "<color=#2458C9>바다가 선택한 고래</color>…? 그래서 나만 네 목소리가 들렸던 거였구나.",
            "voice": "Dubbing_Beluga/Beluga_Audio_19"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Sad",
            "dialogue": "너를 만나러 직접 찾아가고 싶었지만…\n저 까만 오염이 나를 이 곳에 가둬버리는 바람에, 한 발짝도 움직일 수 없었어.",
            "voice": "Dubbing_Beluga/Beluga_Audio_20"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Sad",
            "dialogue": "그런데, 그러는 와중에도 자꾸 친구들 생각이 났어.\n나보다 더 아파할 친구들이 걱정돼서...",
            "voice": "Dubbing_Beluga/Beluga_Audio_21"
        },
        {
            "type": "beluga",
            "expression": "Teardrop_L",
            "dialogue": "그래서 부탁한 거야. 나를 찾기 전에 친구들부터 도와달라고.",
            "voice": "Dubbing_Beluga/Beluga_Audio_22"
        },
        {
            "type": "whale",
            "expression": "Eyes_Sad",
            "dialogue": "아, 그래서 나를 친구들한테 먼저 데려간 거였어.\n그 반짝이던 빛이… 너였구나.",
            "voice": "Dubbing_Beluga/Beluga_Audio_23"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Blink",
            "dialogue": "맞아. 고래 너가 친구들을 잘 찾아갈 수 있도록 내가 보낸 빛이었어.",
            "voice": "Dubbing_Beluga/Beluga_Audio_24"
        },
        {
            "type": "beluga",
            "expression": "Eyes_Annoyed",
            "dialogue": "있잖아, 네가 도와준 친구들이 어쩌다 그렇게 됐는지 너한테 보여주고 싶어.",
            "voice": "Dubbing_Beluga/Beluga_Audio_25"
        }
    ]
}
