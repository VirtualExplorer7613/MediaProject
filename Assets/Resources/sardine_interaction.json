{
    "character": "sardine",
    "icon_on_detected": true,
    "expressions": {
        "default": "Eyes_Blink",
        "start_dialogue": "Eyes_Trauma",
        "post_interaction": "Eyes_Shrink"
    },
    "dialogue_sequence": [
        {
            "type": "player_detects",
            "dialogue": null,
            "action": "remove_question_icon"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Trauma",
            "dialogue": "흑흑… 엄마, 아빠 어디 있는 거야…?\n여긴 너무 깜깜해…",
            "voice": ""
        },
        {
            "type": "sardine",
            "expression": "Eyes_Trauma",
            "dialogue": "나 혼자 남겨지긴 싫어…\n누가 좀… 도와주세요…",
            "voice": ""
        },
        {
            "type": "whale",
            "dialogue": "'이건… 정어리 목소리인데? 박스에 갇혀버린 걸지도 몰라.\n파도 스킬을 이용해서 얼른 구해줘야겠어.'"
        },
        {
            "type": "interaction",
            "dialogue": null,
            "action": "파도 스킬 사용해 종이박스 제거"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Shrink",
            "dialogue": "어… 어라? 앞이 보이잖아!\n고래님이 절 구해주신 거군요! 정말 감사해요…",
            "voice": ""
        },
        {
            "type": "sardine",
            "expression": "Eyes_Sad",
            "dialogue": "갑자기 큰 박스 같은 게 날아와서…\n순식간에 저를 덮쳐버렸어요.",
            "voice": ""
        },
        {
            "type": "sardine",
            "expression": "Eyes_Sad",
            "dialogue": "분명 가족들을 따라 헤엄치고 있었는데…\n아무 소리도 안 들리고, 앞은 캄캄하고…\n그렇게 저 혼자 남겨졌어요.",
            "voice": ""
        },
        {
            "type": "sardine",
            "expression": "Eyes_Blink",
            "dialogue": "그래도 그 캄캄한 박스 안에서 신기하게 <color=#42A5F5>따스한 기운</color>이 느껴졌어요.\n마치 누군가 안아주는 것 같아서 조금 덜 무서웠거든요.",
            "voice": ""
        },
        {
            "type": "whale",
            "dialogue": "'(캄캄한 박스 안에서도 곁에 있어 줬구나…\n정어리가 무서워할 때 그 <color=#42A5F5>따스한 기운</color>으로 달래준 거였어.)'"
        },
        {
            "type": "whale",
            "dialogue": "'(나를 부른 그 존재는 보이지 않는 곳에서 계속 바다 친구들을 돕고 있었어.\n점점 그 목소리의 주인공과 가까워지는 느낌이야.)'"
        },
        {
            "type": "whale",
            "dialogue": "네 눈앞을 막고 있던 건 종이박스야.\n바다에 떠다니다가 네가 가던 길을 가로막은 것 같아."
        },
        {
            "type": "sardine",
            "expression": "Eyes_Sad",
            "dialogue": "그랬군요…\n이대로 가족들을 영영 못 만나게 되는 줄 알고 너무 무서웠어요…",
            "voice": ""
        },
        {
            "type": "sardine",
            "expression": "Eyes_Happy",
            "dialogue": "아! 저기… 보여요!\n저기 제 가족들이 있어요!",
            "voice": ""
        },
        {
            "type": "sardine",
            "expression": "Eyes_Happy",
            "dialogue": "전 이만 가족들에게 돌아가야겠어요.\n도와주셔서 정말 고맙습니다.",
            "voice": ""
        },
        {
            "type": "whale",
            "dialogue": "'길을 막은 건 겨우 종이박스 하나뿐인데…\n종이박스 때문에 정어리는 가족과 영영 헤어질 뻔 했어.'"
        },
        {
            "type": "whale",
            "dialogue": "'바다에 왜 이런 쓰레기들이 계속 늘어가고 있는 걸까…'"
        }
    ]
}