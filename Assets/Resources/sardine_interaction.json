{
    "character": "sardine",
    "icon_on_detected": true,
    "expressions": {
        "default": "Eyes_Blink",
        "start_dialogue": "Eyes_Trauma",
        "post_interaction": "Eyes_Shrink"
    },
    "dialogue_sequence": [
        {
            "type": "player_detects",
            "dialogue": null,
            "action": "remove_question_icon"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Trauma",
            "dialogue": "엄마, 아빠 어디 있는 거야?\n여긴 너무 깜깜해…",
            "voice": "Dubbing_Sardine/Sardine_Audio_01"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Trauma",
            "dialogue": "나 혼자 남겨지긴 싫어…\n누가 좀 도와주세요…",
            "voice": "Dubbing_Sardine/Sardine_Audio_02"
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "(이건, 정어리의 목소리인데?)",
            "voice": "Dubbing_Sardine/Sardine_Audio_03"
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "(설마… 바다에 떠다니는 저 종이박스 안에 갇혀버린 건가?)",
            "voice": "Dubbing_Sardine/Sardine_Audio_04"
        },
        {
            "type": "whale",
            "expression": "Eyes_Blink",
            "dialogue": "(종이라서 가벼워 보여... <color=#0097CE>강한 물살</color>을 일으키면 저 멀리 밀어낼 수 있겠어!)",
            "voice": "Dubbing_Sardine/Sardine_Audio_05"
        },
        {
            "type": "interaction",
            "dialogue": null,
            "action": "파도 스킬 사용해 종이박스 제거"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Shrink",
            "dialogue": "어… 어라? 앞이 보인다!",
            "voice": "Dubbing_Sardine/Sardine_Audio_06"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Happy",
            "dialogue": "고래님이 절 구해주신 거군요! 정말 감사해요!",
            "voice": "Dubbing_Sardine/Sardine_Audio_07"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Sad",
            "dialogue": "가족들이랑 헤엄치고 있었는데...\n이 박스가 갑자기 저를 덮쳐버렸어요.",
            "voice": "Dubbing_Sardine/Sardine_Audio_08"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Blink",
            "dialogue": "아무 소리도 안 들리고 앞은 캄캄해서 너무 무서웠는데…\n그 안에서 신기하게 <color=#FF8DA1>따스한 기운</color> 같은 게 느껴졌어요.",
            "voice": "Dubbing_Sardine/Sardine_Audio_09"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Happy",
            "dialogue": "마치 누군가 저를 꼭 안아주는 것 같았어요.\n그 <color=#FF8DA1>따스한 기운</color> 덕분에 덜 무서웠어요!",
            "voice": "Dubbing_Sardine/Sardine_Audio_10"
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "(나를 불렀던 그 목소리가 정어리를 달래주었나 봐.\n보이지 않는 곳에서 계속 바다 친구들을 돕고 있었구나.)",
            "voice": "Dubbing_Sardine/Sardine_Audio_11"
        },
        {
            "type": "whale",
            "expression": "Eyes_Blink",
            "dialogue": "(점점 그 목소리의 주인공과 가까워지는 느낌이야.)",
            "voice": "Dubbing_Sardine/Sardine_Audio_12"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Shrink",
            "dialogue": "어! 저기 보여요! 저기 제 가족들이 있어요!",
            "voice": "Dubbing_Sardine/Sardine_Audio_13"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Happy",
            "dialogue": "참! 종이박스 안에 같이 떠다니던 <color=#AFBB33>푹신푹신한 물건</color>이 있었거든요.",
            "voice": "Dubbing_Sardine/Sardine_Audio_14"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Happy",
            "dialogue": "절 구해주신 답례로 드릴게요.\n가져가시면 어딘가 꼭 쓸 일이 있을 거예요!",
            "voice": "Dubbing_Sardine/Sardine_Audio_15"
        },
        {
            "type": "sardine",
            "expression": "Eyes_Happy",
            "dialogue": "그럼 저는 이만 가족들에게 돌아가 봐야겠어요.\n고래님, 정말 감사했어요!",
            "voice": "Dubbing_Sardine/Sardine_Audio_16"
        },
        {
            "type": "whale",
            "expression": "Eyes_Sad",
            "dialogue": "(길을 막은 건 겨우 종이박스 하나뿐인데…\n이 작은 쓰레기 하나 때문에 정어리는 가족과 영영 헤어질 뻔했어.)",
            "voice": "Dubbing_Sardine/Sardine_Audio_17"
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "(정어리가 준 이 스폰지를 유용하게 써야겠어.\n더 늦기 전에 도움이 필요한 다른 친구들을 찾으러 가보자!)",
            "voice": "Dubbing_Sardine/Sardine_Audio_18"
        }
    ]
}