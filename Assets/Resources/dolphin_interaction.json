{
    "character": "dolphin",
    "icon_on_detected": true,
    "expressions": {
        "default": "Eyes_Blink",
        "start_dialogue": "Eyes_Trauma",
        "post_interaction": "Eyes_Cry"
    },
    "dialogue_sequence": [
        {
            "type": "player_detects",
            "dialogue": null,
            "action": "remove_question_icon"
        },
        {
            "type": "dolphin",
            "expression": "Eyes_Trauma",
            "dialogue": "아야... 누가 나 좀 도와줘요! 너무 아파!\n입이 따끔거려서 아무것도 할 수가 없어...!",
            "voice": "Dubbing_Dolphin/Dolphin_Audio_01"
        },
        {
            "type": "whale",
            "expression": "Eyes_Shrink",
            "dialogue": "돌고래야! 괜찮아?!",
            "voice": "Dubbing_Dolphin/Dolphin_Audio_02"
        },
        {
            "type": "whale",
            "expression": "Eyes_LookIn",
            "dialogue": "(바늘이 너무 커서 잘못 건드렸다간 상처가 더 커지겠어.\n내가 가진 도구 중에서 바늘을 <color=#F36325>콕 집어낼 수 있을만한 도구</color>를 써보자!)",
            "voice": "Dubbing_Dolphin/Dolphin_Audio_03"
        },
        {
            "type": "interaction",
            "dialogue": null,
            "action": "핀셋 아이템 사용해 입에 박힌 낚싯바늘 제거"
        },
        {
            "type": "whale",
            "expression": "Eyes_Sad",
            "dialogue": "...어쩌다 이렇게 날카로운 바늘이 입에 박히게 된 거니?",
            "voice": "Dubbing_Dolphin/Dolphin_Audio_04"
        },
        {
            "type": "dolphin",
            "expression": "Eyes_Cry",
            "dialogue": "오랜만에 숨 쉬러 물 위로 올라갔다가... 사람들을 만났어요.\n저는 사람들이 좋아서 늘 가까이 가서 인사하곤 했거든요.",
            "voice": "Dubbing_Dolphin/Dolphin_Audio_05"
        },
        {
            "type": "dolphin",
            "expression": "Eyes_Cry",
            "dialogue": "그런데 이번엔 사람들이 갑자기 반짝이는 걸 저한테 던졌어요.\n장난감인 줄 알고 신나서 다가갔는데...",
            "voice": "Dubbing_Dolphin/Dolphin_Audio_06"
        },
        {
            "type": "dolphin",
            "expression": "Eyes_Trauma",
            "dialogue": "갑자기 날카로운 게 제 입에 탁! 하고 걸리더니,\n사람들이 줄을 당겨서 저를 끌고 가려고 했어요...",
            "voice": "Dubbing_Dolphin/Dolphin_Audio_07"
        },
        {
            "type": "dolphin",
            "expression": "Eyes_Sad",
            "dialogue": "너무 아프고 무서워서 있는 힘껏 도망쳐서 여기까지 왔어요...\n이제는 사람들 가까이 가는 게... 너무 무서워요.",
            "voice": "Dubbing_Dolphin/Dolphin_Audio_08"
        },
        {
            "type": "dolphin",
            "expression": "Eyes_Sad",
            "dialogue": "고래님이 아니었으면 저는 진짜 큰일 났을 거예요.\n정말, 정말 고마워요...",
            "voice": "Dubbing_Dolphin/Dolphin_Audio_09"
        },
        {
            "type": "whale",
            "expression": "Eyes_Sad",
            "dialogue": "너처럼 작은 아이를 이렇게까지 크게 다치게 하다니...\n도대체 바다 위에서 무슨 일이 벌어지고 있는 걸까...",
            "voice": "Dubbing_Dolphin/Dolphin_Audio_10"
        },
        {
            "type": "whale",
            "expression": "Eyes_Sad",
            "dialogue": "(사람들은 모르겠지. 바늘 하나가...\n사람을 좋아하던 이 작은 친구의 마음까지 다치게 했다는 걸.)",
            "voice": "Dubbing_Dolphin/Dolphin_Audio_11"
        }
    ]
}